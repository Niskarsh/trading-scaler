# Dhan API Authentication
DHAN_CLIENT_ID="your_dhan_client_id_here"
DHAN_MPIN="your_dhan_mpin_here"

# Application Defaults (Risk & Math Engine)
NEXT_PUBLIC_DEFAULT_RISK="50"
NEXT_PUBLIC_DEFAULT_SUBSEQUENT_ENTRIES="3"
